# Copy this file to backend/.env (or export these as shell variables) and fill in
# real values for local development. Never commit backend/.env — it is already
# excluded from version control.

# --- Database (MySQL 8) ---
# Works unchanged whether MySQL is installed locally as a system service, or started
# via `docker compose up -d mysql` — both use the same variables.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=onehelp
DB_USERNAME=onehelp
DB_PASSWORD=changeme

# --- JWT ---
# Must be a long, random value (at least 256 bits / 32 characters). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=changeme-generate-a-real-random-secret-at-least-32-characters-long

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Docker Compose only (Option B) ---
# Used by compose.yml; irrelevant if you install MySQL locally (Option A).
MYSQL_ROOT_PASSWORD=changeme-root-password
