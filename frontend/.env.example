VITE_API_BASE_URL=http://localhost:8080/api/v1

# Public OpenStreetMap tile server — fine for local development and a
# low-volume MVP, but NOT for unlimited production hosting (see OSM's
# tile usage policy). Swap this for a paid/managed provider or
# self-hosted tiles before any real production traffic.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
