VITE_API_BASE_URL=http://localhost:8080/api/v1

# Mixed mock/API data-source switch. Read only by services that already have a real
# backend to call — currently just `features/auth/services/auth.service.js`. Every
# other feature's service module continues calling its own mock unconditionally,
# regardless of this value, until that domain's own backend phase ships (see
# docs/backend-discovery/frontend-backend-replacement-map.md's incremental order).
# `mock` = auth also uses local mock data (no backend required).
# `api`  = auth calls the real Spring Boot backend at VITE_API_BASE_URL.
VITE_DATA_SOURCE=api

# Public OpenStreetMap tile server — fine for local development and a
# low-volume MVP, but NOT for unlimited production hosting (see OSM's
# tile usage policy). Swap this for a paid/managed provider or
# self-hosted tiles before any real production traffic.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
